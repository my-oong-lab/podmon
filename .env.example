# podmon configuration via .env file
# Copy to ~/.config/podmon/.env or ./.env and edit.
# Values here are overridden by real environment variables and CLI flags.

# Address and port to listen on
PODMON_LISTEN=0.0.0.0:8080

# Login username
PODMON_USER=admin

# Password: set ONE of these (PODMON_PASSWORD_FILE preferred)
# PODMON_PASSWORD_FILE=/home/user/.config/podmon/password
# PODMON_PASSWORD=your-password-here

# Sampling interval (1s to 60s)
PODMON_INTERVAL=2s

# TLS certificate and key (both required together)
# PODMON_TLS_CERT=/path/to/cert.pem
# PODMON_TLS_KEY=/path/to/key.pem

# Comma-separated Host header allowlist
# PODMON_ALLOWED_HOSTS=myhome.local

# Podman API socket path (auto-detect if empty)
# PODMON_SOCKET=

# Absolute path to podman binary for CLI fallback
# PODMON_BIN=/usr/bin/podman

# Disable authentication (loopback only, no password)
# PODMON_NO_AUTH=false